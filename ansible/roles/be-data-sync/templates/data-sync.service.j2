{{ ansible_managed | comment }}

[Unit]
Description=data-sync FastAPI service
Documentation=https://github.com/example/data-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ data_sync_user }}
Group={{ data_sync_group }}
WorkingDirectory={{ data_sync_root }}/src

# Credentials live here, not in this unit: unit files are world-readable.
EnvironmentFile={{ data_sync_env_file }}

ExecStart={{ data_sync_venv }}/bin/uvicorn app.main:app \
    --host {{ data_sync_bind_host }} \
    --port {{ data_sync_bind_port }} \
    --workers {{ data_sync_workers }} \
    --log-level {{ data_sync_log_level | lower }}

ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec={{ data_sync_restart_sec }}
KillMode=mixed
TimeoutStopSec=30

# Hardening. The service needs no write access outside its own tree and no
# elevated capabilities; these are cheap and cut the blast radius of a compromise.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ data_sync_root }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
