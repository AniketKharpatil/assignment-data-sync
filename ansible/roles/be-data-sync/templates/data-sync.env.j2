{{ ansible_managed | comment }}
# systemd parses this as KEY=value, one per line. Values are NOT shell-expanded
# and must not be quoted, or the quotes become part of the value.

APP_ENV={{ data_sync_app_env }}
LOG_LEVEL={{ data_sync_log_level }}
REDIS_HOST={{ data_sync_redis_host }}
REDIS_PORT={{ data_sync_redis_port }}
REDIS_PASSWORD={{ data_sync_redis_password }}
WORKERS={{ data_sync_workers }}
MAX_CONNECTIONS={{ data_sync_max_connections }}
